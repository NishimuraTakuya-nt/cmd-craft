#!/bin/bash
# Claude Code の sandbox 用に、AWS の一時的な認証情報を ~/.claude/sandbox/.aws に作る。
# ふだんの ~/.aws には書かない。ふだんのターミナルで実行する（sandbox からは TOTP の秘密を読めない）。
# Claude Code は settings.json の env（AWS_SHARED_CREDENTIALS_FILE、AWS_CONFIG_FILE）でこのファイルを読む。
# 使い方: setup-aws-credentials-claude [有効期間の秒数（既定 3600、900〜129600）]

set -eo pipefail

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
DURATION="${1:-3600}"
AWS_DIR="$HOME/.claude/sandbox/.aws"

if ! [[ "$DURATION" =~ ^[0-9]+$ ]] || (( DURATION < 900 || DURATION > 129600 )); then
    echo "Error: duration must be 900-129600 seconds" >&2
    exit 1
fi

# 環境変数読み込み
LOAD_ENV_SCRIPT="${SCRIPT_DIR}/load_env.sh"
if [ -f "$LOAD_ENV_SCRIPT" ]; then
    source "$LOAD_ENV_SCRIPT"
    load_env_vars
else
    echo "Error: Cannot find load_env.sh script" >&2
    exit 1
fi

# 念のため、enduring はふだんのファイルから読む
unset AWS_SHARED_CREDENTIALS_FILE AWS_CONFIG_FILE

token_code=$(oathtool --totp --base32 "${TOTP_SECRET}")
if ! credentials=$(aws sts get-session-token --profile enduring --duration-seconds "$DURATION" \
        --serial-number "$IAM_TOTP_MFA_ARN" --token-code "$token_code"); then
    echo "Error: get-session-token failed. 直前に同じ TOTP のコードを使った（v2 を続けて実行したなど）ときは、30 秒待ってやり直す" >&2
    exit 1
fi

umask 077
mkdir -p "$AWS_DIR"

# 一時ファイルに書いてから置き換え、書きかけのファイルを読ませない
tmp=$(mktemp "$AWS_DIR/.credentials.XXXXXX")
trap 'rm -f "$tmp"' EXIT
jq -r '.Credentials
    | "# expiration: \(.Expiration)",
      "[default]",
      "aws_access_key_id = \(.AccessKeyId)",
      "aws_secret_access_key = \(.SecretAccessKey)",
      "aws_session_token = \(.SessionToken)"' <<< "$credentials" > "$tmp"
mv "$tmp" "$AWS_DIR/credentials"

if [ ! -f "$AWS_DIR/config" ]; then
    printf '[default]\nregion = ap-northeast-1\noutput = json\n' > "$AWS_DIR/config"
fi

echo "Wrote $AWS_DIR/credentials (expires $(jq -r .Credentials.Expiration <<< "$credentials"))"
